{
    "timezone": "Europe/Brussels",
    "schedule": {
        "Mon": {"08:30": "0", "12:00": "0", "15:00": "0"},
        "Tue": {"08:30": "0", "12:00": "0", "15:00": "0"},
        "Wed": {"08:30": "0", "12:00": "0"},
        "Thu": {"08:30": "0", "12:00": "0", "15:00": "0"},
        "Fri": {"08:30": "0", "12:00": "0", "15:00": "0"}
    },
    "wav": {
        "0": "SchoolBell-SoundBible.com-449398625.wav",
        "1": "ClassBell-SoundBible.com-1426436341.wav"
    },
    "root": "${HOME}/samples",
    "manual_bell": {
        "gpio": 17,
        "wav_key": "0",
        "mode": "once",
        "pull": "up",
        "bounce_time": 0.05,
        "remote_bells": [
            {
                "transport": "ssh",
                "host": "pibell-yard.local",
                "user": "pi",
                "command": ["/usr/local/bin/manual-bell"],
                "timeout": 5
            },
            {
                "transport": "webhook",
                "url": "https://remote-bell.example.com/bell",
                "auth": {
                    "type": "bearer",
                    "token": "replace-with-remote-token"
                },
                "timeout": 5
            }
        ]
    },
    "webhook": {
        "enabled": false,
        "host": "127.0.0.1",
        "port": 8081,
        "token": "replace-with-a-long-random-token",
        "rate_limit": 10,
        "rate_window": 60
    },
    "holidays": "BE-NL",
    "disable_calendar": "https://example.com/public-calendar.ics",
    "timeout": 10
}
